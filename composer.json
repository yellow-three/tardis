{
    "name": "yellow-three/tardis",
    "description": "Tardis Admin Panel Framework",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "admin", "livewire", "tardis", "bread"],
    "authors": [
        {
            "name": "Yellow Three",
            "email": "hello@yellowthree.dev"
        }
    ],
    "autoload": {
        "psr-4": {
            "Tardis\\": "src/"
        },
        "files": [
            "src/legacy-aliases.php",
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tardis\\TardisServiceProvider"
            ],
            "aliases": {
                "Tardis": "Tardis\\Facades\\Tardis"
            }
        }
    },
    "require": {
        "php": "^8.3",
        "blade-ui-kit/blade-heroicons": "^2.7",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.27",
        "openspout/openspout": "^4.28",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-livewire": "^4.1"
    },
    "suggest": {
        "bacon/bacon-qr-code": "Draws a QR code when a user turns on two-factor authentication (^3.0).",
        "openspout/openspout": "Adds Excel (.xlsx) export and import to BREAD lists next to CSV (^4.28)."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "lint": "./vendor/bin/pint --test",
        "lint-fix": "./vendor/bin/pint",
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=1G"
    }
}
